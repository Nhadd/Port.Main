{
  "rules": {
    ".read": false,
    ".write": false,
    "portfolioAdmins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "portfolioContent": {
      "site": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'mplk1JMenjfCgSix8rhe3Zourpu2' && newData.exists()",
        ".validate": "newData.hasChildren(['schema', 'revision', 'updatedAt', 'payload'])",
        "schema": {
          ".validate": "newData.isNumber() && newData.val() === 1"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 300000"
        },
        "payload": {
          ".validate": "newData.isString() && newData.val().length <= 1000000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}